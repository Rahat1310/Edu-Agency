# App
# Public origin of this deployment (used for Clerk redirects, webhooks, and absolute URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public WhatsApp number in international format without a leading plus (used by click-to-chat links).
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER=

# Database — Neon Postgres (Drizzle + @neondatabase/serverless HTTP driver)
# Pooled/serverless connection string for Vercel functions and the app runtime.
DATABASE_URL=
# Direct (unpooled) connection string for Drizzle migrations and one-off scripts.
DATABASE_URL_UNPOOLED=

# Auth — Clerk
# Publishable key for the Clerk browser SDK (safe to expose).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional Clerk Frontend API host for a tighter CSP (e.g. https://your-app.clerk.accounts.dev).
NEXT_PUBLIC_CLERK_FRONTEND_API=
# Server-side Clerk secret for session verification and the Backend API.
CLERK_SECRET_KEY=
# Signing secret used to verify Clerk webhook payloads.
CLERK_WEBHOOK_SECRET=
# Clerk-hosted sign-in path used by middleware redirects.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Clerk-hosted sign-up path used by middleware redirects.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Where to send students/staff after a successful sign-in.
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/portal
# Where to send new accounts after sign-up.
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/portal

# File storage — Cloudflare R2 (S3-compatible, signed URLs only)
# Cloudflare account ID that owns the R2 bucket.
R2_ACCOUNT_ID=
# R2 API access key ID for server-side uploads and signed URL generation.
R2_ACCESS_KEY_ID=
# R2 API secret access key (never expose to the client).
R2_SECRET_ACCESS_KEY=
# Name of the private documents bucket.
R2_BUCKET_NAME=
# S3-compatible endpoint, typically https://<ACCOUNT_ID>.r2.cloudflarestorage.com.
R2_ENDPOINT=
# Public origin for founder-approved marketing photos (success stories).
# Use an r2.dev subdomain or custom domain on a *public* bucket — not signed
# URLs from the private documents bucket. Leave empty to omit photos.
R2_PUBLIC_BASE_URL=

# Caching — Upstash Redis
# REST URL for the Upstash Redis database (cache + rate limits).
UPSTASH_REDIS_REST_URL=
# REST token for authenticating Upstash Redis commands.
UPSTASH_REDIS_REST_TOKEN=

# Spam protection — Cloudflare Turnstile (public forms)
# Site key rendered on lead/contact/eligibility forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret used to verify Turnstile tokens on the server.
TURNSTILE_SECRET_KEY=

# Email — Resend
# API key for transactional email (offers, reminders, magic links).
RESEND_API_KEY=
# Default From address, e.g. Edu Agency <noreply@example.com>.
EMAIL_FROM=

# WhatsApp Business Cloud API (Meta)
# Long-lived access token for the WhatsApp Business Cloud API.
WHATSAPP_ACCESS_TOKEN=
# Phone number ID that sends student-facing WhatsApp messages.
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID for template and WABA management.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Verify-token string Meta will send when registering the webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret used to validate X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=

# Facebook Messenger Platform API
# Facebook App ID for the Messenger integration.
FACEBOOK_APP_ID=
# App secret used to validate Messenger webhook signatures.
FACEBOOK_APP_SECRET=
# Page access token for the agency Facebook Page.
FACEBOOK_PAGE_ACCESS_TOKEN=
# Facebook Page ID that receives student Messenger conversations.
FACEBOOK_PAGE_ID=
# Verify-token string Facebook will send when registering the webhook.
FACEBOOK_VERIFY_TOKEN=

# SMS — local Bangladeshi aggregator (OTP and reminders)
# Aggregator API base URL.
SMS_API_URL=
# Aggregator API key or token.
SMS_API_KEY=
# Sender ID / mask approved for Bangladesh traffic.
SMS_SENDER_ID=

# AI — Groq, Gemini, OpenRouter (gateway in lib/ai; SOP/chat/matching later)
# Groq (Llama on LPUs). First in the 'chat' chain.
GROQ_API_KEY=
# Google AI Studio key for Gemini Flash. First in the 'matching' chain.
GEMINI_API_KEY=
# OpenRouter key; used as the :free last-resort in both chains.
OPENROUTER_API_KEY=
# Anthropic API key for Claude-based assistants (not used by the gateway yet).
ANTHROPIC_API_KEY=
# OpenAI API key if that provider is used instead of (or alongside) Anthropic.
OPENAI_API_KEY=

# Background jobs — Trigger.dev or Inngest (nurture sequences, deadline reminders)
# Trigger.dev secret key for authenticating background tasks.
TRIGGER_SECRET_KEY=
# Inngest event key for sending events from the app.
INNGEST_EVENT_KEY=
# Inngest signing key for verifying incoming function requests.
INNGEST_SIGNING_KEY=
# Comma-separated calendar days before an intake deadline to email a reminder (Dhaka date).
INTAKE_REMINDER_WINDOWS=14,7,2
# Nurture sequence timing lives in lib/nurture/sequence.ts (not env), so the founder can edit buckets without a redeploy of matcher code.

# Monitoring — Sentry
# Server/edge Sentry DSN for error reports.
SENTRY_DSN=
# Browser Sentry DSN (public, project-scoped).
NEXT_PUBLIC_SENTRY_DSN=
# Auth token for uploading source maps during CI builds.
SENTRY_AUTH_TOKEN=
# Sentry organization slug for the source-map upload plugin.
SENTRY_ORG=
# Sentry project slug for the source-map upload plugin.
SENTRY_PROJECT=

# Analytics — PostHog
# PostHog project API key (public).
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog host, e.g. https://us.i.posthog.com or a self-hosted URL.
NEXT_PUBLIC_POSTHOG_HOST=

# Analytics — Google Analytics + Search Console
# GA4 measurement ID (G-XXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
