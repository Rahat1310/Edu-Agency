{
  "name": "edu-agency",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"console.log('Vitest is not configured yet (comes in 1.5).')\"",
    "test:e2e": "node -e \"console.log('Playwright is not configured yet (comes in 1.5).')\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "reminders:run": "npx tsx scripts/run-intake-reminders.ts",
    "nurture:run": "npx tsx scripts/run-lead-nurture.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1111.0",
    "@aws-sdk/s3-request-presigner": "3.1111.0",
    "@clerk/nextjs": "7.7.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.0",
    "@neondatabase/serverless": "^1.1.0",
    "@types/three": "^0.185.4",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.1.0",
    "globe.gl": "^2.46.2",
    "inngest": "^4.18.1",
    "lucide-react": "^1.31.0",
    "next": "15.5.23",
    "radix-ui": "^1.6.7",
    "react": "^19.1.4",
    "react-dom": "^19.1.4",
    "react-hook-form": "^7.85.0",
    "resend": "^6.20.0",
    "shadcn": "^4.18.0",
    "svix": "1.99.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.46.0"
  }
}
